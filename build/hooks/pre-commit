#!/bin/sh
# Проверка индекса на секреты перед коммитом.
# Установка: cp build/hooks/pre-commit .git/hooks/ ; gitleaks — в bin/ или PATH
#   GOBIN=$PWD/bin go install github.com/zricethezav/gitleaks/v8@v8.30.1
GL=bin/gitleaks.exe
[ -x "$GL" ] || GL=bin/gitleaks
[ -x "$GL" ] || GL=$(command -v gitleaks)
if [ -z "$GL" ]; then
  echo "pre-commit: gitleaks не найден — установите его (см. build/hooks/pre-commit)" >&2
  exit 1
fi
exec "$GL" git --pre-commit --staged --redact --no-banner -v .
